#property copyright "Copyright 2025, DalyDough Ltd"
#property link      "https://dalydough.com"
#property version   "1.00"

#include <Trade\Trade.mqh>

//--- Input parameters
input string EA_Key = "";                    // Your unique EA Key from DalyDough
input int Update_Frequency_Seconds = 5;     // How often to sync with server (seconds)

//--- Global variables
bool isAuthenticated = false;
string baseURL = "https://firestore.googleapis.com/v1/projects/your-project-id/databases/(default)/documents/";
string accountDocumentPath = "";
string userID = "";
datetime lastUpdate = 0;
datetime lastSymbolSync = 0;
CTrade trade;

//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit()
{
    Print("DalyDough EA starting...");
    
    if(StringLen(EA_Key) == 0)
    {
        Print("ERROR: EA_Key is required. Please enter your unique EA Key from DalyDough.");
        return(INIT_FAILED);
    }
    
    if(!AuthenticateEA())
    {
        Print("ERROR: Authentication failed. Please check your EA_Key.");
        return(INIT_FAILED);
    }
    
    if(!EventSetTimer(Update_Frequency_Seconds))
    {
        Print("ERROR: Failed to set timer.");
        return(INIT_FAILED);
    }
    
    UpdateAccountStatus();
    SyncBrokerSymbols();
    
    Print("DalyDough EA initialized successfully!");
    return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| Expert deinitialization function                                 |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
    EventKillTimer();
    Print("DalyDough EA stopped.");
}

//+------------------------------------------------------------------+
//| Timer function                                                   |
//+------------------------------------------------------------------+
void OnTimer()
{
    if(!isAuthenticated) 
        return;
    
    UpdateAccountStatus();
    UpdatePositionsPnL();
    ProcessBotCommands();
    
    if(TimeCurrent() - lastSymbolSync > 3600)
    {
        SyncBrokerSymbols();
        lastSymbolSync = TimeCurrent();
    }
    
    lastUpdate = TimeCurrent();
}

//+------------------------------------------------------------------+
//| Authenticate EA                                                  |
//+------------------------------------------------------------------+
bool AuthenticateEA()
{
    string url = baseURL + "tradeAccounts/" + EA_Key;
    string headers = "Content-Type: application/json\r\n";
    
    char data[];
    char result[];
    string resultHeaders;
    int timeout = 5000;
    
    int res = WebRequest("GET", url, headers, timeout, data, result, resultHeaders);
    
    if(res == 200)
    {
        string response = CharArrayToString(result);
        
        if(StringFind(response, "\"name\"") >= 0)
        {
            isAuthenticated = true;
            accountDocumentPath = "tradeAccounts/" + EA_Key;
            
            int uidStart = StringFind(response, "\"uid\"");
            if(uidStart >= 0)
            {
                uidStart = StringFind(response, "\"", uidStart + 6) + 1;
                int uidEnd = StringFind(response, "\"", uidStart);
                userID = StringSubstr(response, uidStart, uidEnd - uidStart);
            }
            
            Print("Authentication successful. User ID: ", userID);
            return true;
        }
    }
    
    Print("Authentication failed. HTTP Code: ", res);
    return false;
}

//+------------------------------------------------------------------+
//| Update account status                                            |
//+------------------------------------------------------------------+
void UpdateAccountStatus()
{
    double balance = AccountInfoDouble(ACCOUNT_BALANCE);
    double equity = AccountInfoDouble(ACCOUNT_EQUITY);
    double marginLevel = AccountInfoDouble(ACCOUNT_MARGIN_LEVEL);
    
    string jsonData = StringFormat(
        "{"
        "\"fields\": {"
        "\"balance\": {\"doubleValue\": %.2f},"
        "\"equity\": {\"doubleValue\": %.2f},"
        "\"marginLevel\": {\"doubleValue\": %.2f},"
        "\"status\": {\"stringValue\": \"Connected\"},"
        "\"lastUpdate\": {\"timestampValue\": \"%s\"}"
        "}"
        "}",
        balance, equity, marginLevel, TimeToString(TimeCurrent(), TIME_DATE|TIME_SECONDS)
    );
    
    SendFirestoreRequest("PATCH", accountDocumentPath, jsonData);
}

//+------------------------------------------------------------------+
//| Sync broker symbols                                              |
//+------------------------------------------------------------------+
void SyncBrokerSymbols()
{
    Print("Starting symbol synchronization...");
    
    int totalSymbols = SymbolsTotal(true);
    int syncedCount = 0;
    
    for(int i = 0; i < totalSymbols; i++)
    {
        string symbol = SymbolName(i, true);
        
        if(!SymbolInfoInteger(symbol, SYMBOL_SELECT))
            continue;
            
        string description = SymbolInfoString(symbol, SYMBOL_DESCRIPTION);
        int digits = (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS);
        double tickSize = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_SIZE);
        double contractSize = SymbolInfoDouble(symbol, SYMBOL_TRADE_CONTRACT_SIZE);
        double minLot = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MIN);
        double maxLot = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MAX);
        double lotStep = SymbolInfoDouble(symbol, SYMBOL_VOLUME_STEP);
        
        string apiSymbol = MapBrokerSymbolToAPI(symbol);
        
        string symbolData = StringFormat(
            "{"
            "\"fields\": {"
            "\"brokerSymbol\": {\"stringValue\": \"%s\"},"
            "\"apiSymbol\": {\"stringValue\": \"%s\"},"
            "\"description\": {\"stringValue\": \"%s\"},"
            "\"digits\": {\"integerValue\": %d},"
            "\"tickSize\": {\"doubleValue\": %.5f},"
            "\"contractSize\": {\"doubleValue\": %.2f},"
            "\"minLot\": {\"doubleValue\": %.2f},"
            "\"maxLot\": {\"doubleValue\": %.2f},"
            "\"lotStep\": {\"doubleValue\": %.2f},"
            "\"accountKey\": {\"stringValue\": \"%s\"},"
            "\"lastUpdated\": {\"timestampValue\": \"%s\"},"
            "\"isActive\": {\"booleanValue\": true}"
            "}"
            "}",
            symbol, apiSymbol, description, digits, tickSize, contractSize,
            minLot, maxLot, lotStep, EA_Key, TimeToString(TimeCurrent(), TIME_DATE|TIME_SECONDS)
        );
        
        string documentPath = "brokerSymbols/" + EA_Key + "_" + symbol;
        if(SendFirestoreRequest("PATCH", documentPath, symbolData))
        {
            syncedCount++;
        }
        
        Sleep(100);
    }
    
    Print("Symbol synchronization completed. Synced ", syncedCount, " of ", totalSymbols, " symbols.");
}

//+------------------------------------------------------------------+
//| Map broker symbol to API format                                 |
//+------------------------------------------------------------------+
string MapBrokerSymbolToAPI(string brokerSymbol)
{
    string apiSymbol = brokerSymbol;
    
    StringReplace(apiSymbol, "m", "");
    StringReplace(apiSymbol, "z", "");
    StringReplace(apiSymbol, "pro", "");
    StringReplace(apiSymbol, ".", "");
    StringReplace(apiSymbol, "_", "");
    
    if(StringLen(apiSymbol) == 6)
    {
        string base = StringSubstr(apiSymbol, 0, 3);
        string quote = StringSubstr(apiSymbol, 3, 3);
        apiSymbol = base + "/" + quote;
    }
    
    if(apiSymbol == "EURUSD" || apiSymbol == "EUR/USD") return "EUR/USD";
    if(apiSymbol == "GBPUSD" || apiSymbol == "GBP/USD") return "GBP/USD";
    if(apiSymbol == "USDJPY" || apiSymbol == "USD/JPY") return "USD/JPY";
    if(apiSymbol == "USDCHF" || apiSymbol == "USD/CHF") return "USD/CHF";
    if(apiSymbol == "AUDUSD" || apiSymbol == "AUD/USD") return "AUD/USD";
    if(apiSymbol == "USDCAD" || apiSymbol == "USD/CAD") return "USD/CAD";
    if(apiSymbol == "NZDUSD" || apiSymbol == "NZD/USD") return "NZD/USD";
    if(apiSymbol == "EURGBP" || apiSymbol == "EUR/GBP") return "EUR/GBP";
    if(apiSymbol == "EURJPY" || apiSymbol == "EUR/JPY") return "EUR/JPY";
    if(apiSymbol == "GBPJPY" || apiSymbol == "GBP/JPY") return "GBP/JPY";
    
    if(StringFind(apiSymbol, "US30") >= 0 || StringFind(apiSymbol, "DOW") >= 0) return "^DJI";
    if(StringFind(apiSymbol, "SPX") >= 0 || StringFind(apiSymbol, "US500") >= 0) return "^GSPC";
    if(StringFind(apiSymbol, "NAS") >= 0 || StringFind(apiSymbol, "US100") >= 0) return "^IXIC";
    if(StringFind(apiSymbol, "DAX") >= 0 || StringFind(apiSymbol, "GER") >= 0) return "^GDAXI";
    if(StringFind(apiSymbol, "FTSE") >= 0 || StringFind(apiSymbol, "UK100") >= 0) return "^FTSE";
    if(StringFind(apiSymbol, "CAC") >= 0 || StringFind(apiSymbol, "FRA40") >= 0) return "^FCHI";
    if(StringFind(apiSymbol, "NIKKEI") >= 0 || StringFind(apiSymbol, "JPN225") >= 0) return "^N225";
    
    if(StringFind(apiSymbol, "GOLD") >= 0 || StringFind(apiSymbol, "XAU") >= 0) return "GC=F";
    if(StringFind(apiSymbol, "SILVER") >= 0 || StringFind(apiSymbol, "XAG") >= 0) return "SI=F";
    if(StringFind(apiSymbol, "OIL") >= 0 || StringFind(apiSymbol, "WTI") >= 0) return "CL=F";
    if(StringFind(apiSymbol, "BRENT") >= 0) return "BZ=F";
    
    if(StringFind(apiSymbol, "BTC") >= 0) return "BTC-USD";
    if(StringFind(apiSymbol, "ETH") >= 0) return "ETH-USD";
    
    return apiSymbol;
}

//+------------------------------------------------------------------+
//| Update positions P/L                                            |
//+------------------------------------------------------------------+
void UpdatePositionsPnL()
{
    string queryData = StringFormat(
        "{"
        "\"structuredQuery\": {"
        "\"where\": {"
        "\"fieldFilter\": {"
        "\"field\": {\"fieldPath\": \"uid\"},"
        "\"op\": \"EQUAL\","
        "\"value\": {\"stringValue\": \"%s\"}"
        "}"
        "},"
        "\"from\": [{\"collectionId\": \"bots\"}]"
        "}"
        "}",
        userID
    );
    
    string url = baseURL + ":runQuery";
    char data[];
    char result[];
    string headers = "Content-Type: application/json\r\n";
    string resultHeaders;
    
    ArrayResize(data, StringToCharArray(queryData, data, 0, WHOLE_ARRAY, CP_UTF8) - 1);
    int res = WebRequest("POST", url, headers, 5000, data, result, resultHeaders);
    
    if(res == 200)
    {
        string response = CharArrayToString(result);
        ParseAndUpdateBotPnL(response);
    }
}

//+------------------------------------------------------------------+
//| Parse and update bot P/L                                        |
//+------------------------------------------------------------------+
void ParseAndUpdateBotPnL(string response)
{
    int pos = 0;
    while((pos = StringFind(response, "\"name\":", pos)) >= 0)
    {
        int pathStart = StringFind(response, "\"", pos + 7) + 1;
        int pathEnd = StringFind(response, "\"", pathStart);
        string botPath = StringSubstr(response, pathStart, pathEnd - pathStart);
        
        int botsPos = StringFind(botPath, "bots/");
        if(botsPos >= 0)
        {
            string botId = StringSubstr(botPath, botsPos + 5);
            double totalPnL = CalculateBotPnL(botId);
            
            string updateData = StringFormat(
                "{"
                "\"fields\": {"
                "\"profit_loss\": {\"doubleValue\": %.2f}"
                "}"
                "}",
                totalPnL
            );
            
            string docPath = StringSubstr(botPath, StringFind(botPath, "documents/") + 10);
            SendFirestoreRequest("PATCH", docPath, updateData);
        }
        
        pos = pathEnd;
    }
}

//+------------------------------------------------------------------+
//| Calculate bot P/L                                               |
//+------------------------------------------------------------------+
double CalculateBotPnL(string botId)
{
    double totalPnL = 0.0;
    
    ulong magicNumber = 0;
    for(int i = 0; i < StringLen(botId) && i < 8; i++)
    {
        magicNumber = magicNumber * 31 + StringGetCharacter(botId, i);
    }
    magicNumber = magicNumber % 2147483647;
    
    for(int i = 0; i < PositionsTotal(); i++)
    {
        if(PositionGetTicket(i) > 0)
        {
            if(PositionGetInteger(POSITION_MAGIC) == (long)magicNumber)
            {
                totalPnL += PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
            }
        }
    }
    
    return totalPnL;
}

//+------------------------------------------------------------------+
//| Process bot commands                                             |
//+------------------------------------------------------------------+
void ProcessBotCommands()
{
    string queryData = StringFormat(
        "{"
        "\"structuredQuery\": {"
        "\"where\": {"
        "\"compositeFilter\": {"
        "\"op\": \"AND\","
        "\"filters\": ["
        "{\"fieldFilter\": {\"field\": {\"fieldPath\": \"uid\"}, \"op\": \"EQUAL\", \"value\": {\"stringValue\": \"%s\"}}},"
        "{\"fieldFilter\": {\"field\": {\"fieldPath\": \"status\"}, \"op\": \"NOT_EQUAL\", \"value\": {\"stringValue\": \"closed\"}}}"
        "]"
        "}"
        "},"
        "\"from\": [{\"collectionId\": \"bots\"}]"
        "}"
        "}",
        userID
    );
    
    string url = baseURL + ":runQuery";
    char data[];
    char result[];
    string headers = "Content-Type: application/json\r\n";
    string resultHeaders;
    
    ArrayResize(data, StringToCharArray(queryData, data, 0, WHOLE_ARRAY, CP_UTF8) - 1);
    int res = WebRequest("POST", url, headers, 5000, data, result, resultHeaders);
    
    if(res == 200)
    {
        string response = CharArrayToString(result);
        ProcessBotDocuments(response);
    }
}

//+------------------------------------------------------------------+
//| Process bot documents                                            |
//+------------------------------------------------------------------+
void ProcessBotDocuments(string response)
{
    int pos = 0;
    while((pos = StringFind(response, "\"document\":", pos)) >= 0)
    {
        int docStart = pos;
        int docEnd = StringFind(response, "}", docStart);
        string botDoc = StringSubstr(response, docStart, docEnd - docStart + 1);
        
        ProcessSingleBot(botDoc);
        
        pos = docEnd;
    }
}

//+------------------------------------------------------------------+
//| Process single bot                                               |
//+------------------------------------------------------------------+
void ProcessSingleBot(string botDoc)
{
    string botId = ExtractStringValue(botDoc, "botId");
    string status = ExtractStringValue(botDoc, "status");
    
    if(status == "close_now" || status == "closed")
    {
        CloseAllBotTrades(botId);
    }
    else if(status == "active")
    {
        ProcessPendingOrders(botDoc, botId);
        CheckStopLossTakeProfit(botDoc, botId);
    }
}

//+------------------------------------------------------------------+
//| Close all bot trades                                            |
//+------------------------------------------------------------------+
void CloseAllBotTrades(string botId)
{
    ulong magicNumber = 0;
    for(int i = 0; i < StringLen(botId) && i < 8; i++)
    {
        magicNumber = magicNumber * 31 + StringGetCharacter(botId, i);
    }
    magicNumber = magicNumber % 2147483647;
    
    for(int i = PositionsTotal() - 1; i >= 0; i--)
    {
        if(PositionGetTicket(i) > 0)
        {
            if(PositionGetInteger(POSITION_MAGIC) == (long)magicNumber)
            {
                ulong ticket = PositionGetTicket(i);
                
                if(trade.PositionClose(ticket))
                {
                    Print("Closed position for bot: ", botId, " Ticket: ", ticket);
                }
                else
                {
                    Print("Failed to close position for bot: ", botId, " Error: ", GetLastError());
                }
            }
        }
    }
}

