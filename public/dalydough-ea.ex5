//+------------------------------------------------------------------+
//| Check stop loss and take profit                                 |
//+------------------------------------------------------------------+
void CheckStopLossTakeProfit(string botDoc, string botId)
{
    double stopLoss = ExtractDoubleValue(botDoc, "stopLoss");
    double takeProfit = ExtractDoubleValue(botDoc, "takeProfit");
    
    if(stopLoss > 0 || takeProfit > 0)
    {
        ulong magicNumber = 0;
        for(int i = 0; i < StringLen(botId) && i < 8; i++)
        {
            magicNumber = magicNumber * 31 + StringGetCharacter(botId, i);
        }
        magicNumber = magicNumber % 2147483647;
        
        for(int i = PositionsTotal() - 1; i >= 0; i--)
        {
            if(PositionGetTicket(i) > 0)
            {
                if(PositionGetInteger(POSITION_MAGIC) == (long)magicNumber)
                {
                    double currentProfit = PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
                    
                    bool shouldClose = false;
                    
                    if(stopLoss > 0 && currentProfit <= -stopLoss)
                    {
                        shouldClose = true;
                        Print("Stop loss triggered for bot: ", botId);
                    }
                    else if(takeProfit > 0 && currentProfit >= takeProfit)
                    {
                        shouldClose = true;
                        Print("Take profit triggered for bot: ", botId);
                    }
                    
                    if(shouldClose)
                    {
                        ulong ticket = PositionGetTicket(i);
                        trade.PositionClose(ticket);
                    }
                }
            }
        }
    }
}

//+------------------------------------------------------------------+
//| Send Firestore request                                           |
//+------------------------------------------------------------------+
bool SendFirestoreRequest(string method, string documentPath, string jsonData)
{
    string url = baseURL + documentPath;
    string headers = "Content-Type: application/json\r\n";
    
    char data[];
    char result[];
    string resultHeaders;
    
    if(method == "PATCH" || method == "POST")
    {
        ArrayResize(data, StringToCharArray(jsonData, data, 0, WHOLE_ARRAY, CP_UTF8) - 1);
    }
    
    int res = WebRequest(method, url, headers, 5000, data, result, resultHeaders);
    
    if(res == 200)
    {
        return true;
    }
    else
    {
        Print("Firestore request failed. Method: ", method, " URL: ", url, " HTTP Code: ", res);
        return false;
    }
}

//+------------------------------------------------------------------+
//| Extract string value from JSON                                  |
//+------------------------------------------------------------------+
string ExtractStringValue(string json, string fieldName)
{
    string searchPattern = "\"" + fieldName + "\"";
    int pos = StringFind(json, searchPattern);
    if(pos < 0) return "";
    
    pos = StringFind(json, "\"stringValue\"", pos);
    if(pos < 0) return "";
    
    pos = StringFind(json, "\"", pos + 13) + 1;
    int endPos = StringFind(json, "\"", pos);
    
    return StringSubstr(json, pos, endPos - pos);
}

//+------------------------------------------------------------------+
//| Extract double value from JSON                                  |
//+------------------------------------------------------------------+
double ExtractDoubleValue(string json, string fieldName)
{
    string searchPattern = "\"" + fieldName + "\"";
    int pos = StringFind(json, searchPattern);
    if(pos < 0) return 0.0;
    
    pos = StringFind(json, "\"doubleValue\"", pos);
    if(pos < 0) return 0.0;
    
    pos = StringFind(json, ":", pos) + 1;
    int endPos = StringFind(json, ",", pos);
    if(endPos < 0) endPos = StringFind(json, "}", pos);
    
    string valueStr = StringSubstr(json, pos, endPos - pos);
    StringReplace(valueStr, " ", "");
    
    return StringToDouble(valueStr);
}