rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Bots can be read by the owner and the EA.
    // Bots can be created/updated by the owner.
    match /bots/{botId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
    }
    
    // TradeAccounts can be read/written by the owner. The EA (unauthenticated) can also write to it.
    match /tradeAccounts/{accountKey} {
      allow write; // Allow EA to update balance, equity, etc.
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // AutoBotStrategies can be read/written by the owner.
    match /autobotStrategies/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // UserSettings can be read/written by the owner.
    match /userSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
